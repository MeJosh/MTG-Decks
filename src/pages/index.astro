---
import { getCollection } from 'astro:content';

import formatImages from '../../config/format-images.json';
import { ScryfallCatalog } from '../lib/cards/scryfall';
import BaseLayout from '../layouts/BaseLayout.astro';

interface FormatImage {
  card: string;
  set: string;
  collectorNumber?: string;
}

interface FormatImageConfiguration {
  format: string;
  displayName?: string;
  card?: string;
  set?: string;
  collectorNumber?: string;
}

const formatNamesByKey = new Map(
  (await getCollection('decks')).map((entry) => [
    entry.data.format.toLocaleLowerCase('en-US'),
    entry.data.format,
  ]),
);
const configuredFormats = formatImages.formats as FormatImageConfiguration[];
const configuredFormatKeys = new Set(
  configuredFormats.map(({ format }) => format.toLocaleLowerCase('en-US')),
);
const formatNames = [
  ...configuredFormats.flatMap(({ format }) => {
    const name = formatNamesByKey.get(format.toLocaleLowerCase('en-US'));
    return name ? [name] : [];
  }),
  ...[...formatNamesByKey.entries()]
    .filter(([format]) => !configuredFormatKeys.has(format))
    .map(([, name]) => name)
    .sort((a, b) => a.localeCompare(b)),
];
const catalog = new ScryfallCatalog();

async function resolveImage(image: FormatImage) {
  try {
    return image.collectorNumber
      ? await catalog.byPrinting(image.set, image.collectorNumber)
      : await catalog.byNameAndSet(image.card, image.set);
  } catch {
    return undefined;
  }
}

function hasImage(image: FormatImageConfiguration): image is FormatImageConfiguration & FormatImage {
  return Boolean(image.card && image.set);
}

const defaultImage = await resolveImage(formatImages.default);
const formats = await Promise.all([
  Promise.resolve({ name: 'All', href: '/all', image: defaultImage }),
  ...formatNames.map(async (name) => {
    const configuration = configuredFormats.find(({ format }) =>
      format.toLocaleLowerCase('en-US') === name.toLocaleLowerCase('en-US'),
    );

    return {
      name: configuration?.displayName ?? name,
      href: `/${name.toLocaleLowerCase('en-US')}`,
      image: configuration && hasImage(configuration)
        ? await resolveImage(configuration) ?? defaultImage
        : defaultImage,
    };
  }),
]);
---

<BaseLayout title="MTG Decks">
  <header class="format-landing-header">
    <p class="eyebrow">Deck library</p>
    <h1>Choose a format.</h1>
  </header>
  <nav class="format-landing-grid" aria-label="Deck formats">
    {formats.map(({ name, href, image }) => (
      <a class="format-landing-tile" href={`${import.meta.env.BASE_URL}${href}`}>
        {image && <img src={image.artCrop} alt="" width="488" height="680" />}
        <span>{name}</span>
      </a>
    ))}
  </nav>
</BaseLayout>
